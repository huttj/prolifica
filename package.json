{
  "name": "prolifica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "deploy": "npm run build && wrangler deploy -c dist/prolifica/wrangler.json",
    "types": "wrangler types",
    "check": "tsc",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply prolifica --local",
    "db:migrate:remote": "wrangler d1 migrations apply prolifica --remote"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "itty-router": "^5.0.24",
    "jsonata": "^2.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
